# ==============================================================================
# Retail Sales Intelligence & Forecasting Platform - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the values with your local configuration.
# NOTE: Never commit your actual '.env' file containing real passwords to GitHub!

# Database Engine Selection: 'mysql' or 'sqlite'
# If DB_TYPE=mysql, the application will connect to your MySQL instance.
# If DB_TYPE=sqlite or MySQL is unreachable, the system automatically uses
# the local SQLite analytical warehouse at data/processed/retail_analytics.db.
DB_TYPE=mysql

# MySQL Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=retail_sales_dw
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Application Configuration
APP_ENV=development
RANDOM_SEED=42
LOG_LEVEL=INFO

# Dashboard Server Settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
